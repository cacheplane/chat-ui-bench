{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": false,
    "noEmit": true
  },
  "include": [
    "../apps/copilotkit/vite.config.ts",
    "support/hosted-copilot-*.ts",
    "../tools/hosted-copilot-api.ts"
  ]
}
