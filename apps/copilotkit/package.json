{
  "name": "@chat-ui-bench/copilotkit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:controls": "tsc -p tsconfig.controls.json --noEmit",
    "typecheck:vendor": "tsc -p tsconfig.vendor.json --noEmit",
    "build:hosted": "vite build --config vite.config.ts",
    "build:worker:hosted": "node ../../tools/hosted-copilot-worker-static.mjs emit",
    "inspect:worker:hosted": "node --experimental-import-meta-resolve ../../tools/hosted-copilot-worker-static.mjs inspect"
  },
  "dependencies": {
    "@copilotkit/react-core": "1.78.0",
    "@copilotkit/core": "1.78.0",
    "@copilotkit/runtime": "1.78.0",
    "@ag-ui/client": "1.0.2",
    "@ag-ui/core": "1.0.2",
    "@ag-ui/encoder": "1.0.2",
    "@hono/node-server": "1.19.17",
    "hono": "4.13.13",
    "rxjs": "7.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
