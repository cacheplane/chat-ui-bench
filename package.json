{
  "name": "chat-ui-bench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:hosted:httpagent": "node tools/hosted-httpagent-admission.mjs && vitest run --config vitest.hosted-httpagent.config.ts --no-color",
    "typecheck": "npm run typecheck --workspaces --if-present && npm run typecheck:fixtures",
    "typecheck:fixtures": "tsc -p tests/tsconfig.types.json",
    "build": "npm run build --workspace @chat-ui-bench/contract && npm run build --workspace @chat-ui-bench/producer && npm run build --workspace @chat-ui-bench/reference && npm run build --workspace @chat-ui-bench/analyzer && npm run build --workspace @chat-ui-bench/runner && npm run build --workspace @chat-ui-bench/threadplane",
    "test:browser": "npm run build && vitest run --config vitest.browser.config.ts",
    "bench:calibrate": "node packages/runner/dist/cli.js",
    "bench:analyze": "node packages/analyzer/dist/cli.js",
    "bench:analyze:comparison": "node packages/analyzer/dist/comparison-cli.js",
    "test:browser:threadplane": "npm run build && vitest run --config vitest.threadplane.browser.config.ts",
    "bench:long-thread": "node packages/runner/dist/long-thread-main.js",
    "test:browser:comparison": "vitest run --config vitest.comparison.browser.config.ts --no-color"
  },
  "devDependencies": {
    "@ag-ui/client": "1.0.2",
    "@copilotkit/aimock": "1.45.1",
    "@types/node": "24.10.1",
    "playwright": "1.64.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "parse5": "7.3.0",
    "rolldown": "1.2.13",
    "lightningcss": "1.33.0"
  },
  "overrides": {
    "@ai-sdk/provider-utils@3.0.41": {
      "undici": "6.29.0"
    },
    "@langchain/core@1.2.9": {
      "langsmith": "0.10.11"
    },
    "socks@2.8.10": {
      "ip-address": "10.7.3"
    },
    "express-rate-limit@8.7.1": {
      "ip-address": "10.7.3"
    }
  }
}
